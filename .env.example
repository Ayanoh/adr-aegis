# ADR-AEGIS Environment Variables Template
# Copy this file to .env and fill in your own keys:
# cp .env.example .env

# Google Gemini API Key (Required for Tier 2 Deep reasoning agents)
GEMINI_API_KEY="your_gemini_api_key_here"

# Hugging Face Access Token (Optional: for downloading gated/private models if needed)
HF_TOKEN="your_huggingface_token_here"
